#!/usr/bin/env sh
# Managed by LasVegasForTransit/repository-tooling. Do not edit this file;
# `pnpm check:repository-tooling` fails on local changes.
#
# The contribution plugin owns the subject policy so its PR helper and this
# hook cannot silently accept different scopes. Repository-specific rules go
# in .lvbt/hooks/commit-msg, which runs only after the shared check passes.
set -eu

MESSAGE_FILE="$1"
SUBJECT=$(head -n 1 "$MESSAGE_FILE")

# Git writes these subjects itself; they do not name an authored change.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

ROOT=$(git rev-parse --show-toplevel)
node "$ROOT/plugins/lvbt-contributions/scripts/validate-commit-subject.mjs" "$SUBJECT"

EXTENSION="$ROOT/.lvbt/hooks/commit-msg"
if [ -x "$EXTENSION" ]; then
  exec "$EXTENSION" "$MESSAGE_FILE"
fi
