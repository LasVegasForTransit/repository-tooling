{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "example": {
                "$ref": "#/$defs/path"
              },
              "file": {
                "$ref": "#/$defs/path"
              }
            },
            "required": ["example", "file"]
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name", "purpose"]
          }
        }
      },
      "required": []
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "artifactName": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "local": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cwd": {
                  "$ref": "#/$defs/path"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                },
                "format": {
                  "enum": ["lychee", "links", "lhci", "lighthouse", "pnpm"]
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": ["command"]
            },
            "production": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cwd": {
                  "$ref": "#/$defs/path"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                },
                "format": {
                  "enum": ["lychee", "links", "lhci", "lighthouse", "pnpm"]
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": ["command"]
            }
          },
          "required": []
        },
        "lighthouse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "local": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cwd": {
                  "$ref": "#/$defs/path"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                },
                "format": {
                  "enum": ["lychee", "links", "lhci", "lighthouse", "pnpm"]
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": ["command"]
            },
            "production": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cwd": {
                  "$ref": "#/$defs/path"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                },
                "format": {
                  "enum": ["lychee", "links", "lhci", "lighthouse", "pnpm"]
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": ["command"]
            }
          },
          "required": []
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "local": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cwd": {
                  "$ref": "#/$defs/path"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                },
                "format": {
                  "enum": ["lychee", "links", "lhci", "lighthouse", "pnpm"]
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": ["command"]
            },
            "production": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cwd": {
                  "$ref": "#/$defs/path"
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                },
                "format": {
                  "enum": ["lychee", "links", "lhci", "lighthouse", "pnpm"]
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": ["command"]
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "appDirectory": {
          "type": "string",
          "minLength": 1
        },
        "productionUrl": {
          "type": "string",
          "minLength": 1
        },
        "previewUrl": {
          "type": "string",
          "minLength": 1
        },
        "productionWorker": {
          "type": "string",
          "minLength": 1
        },
        "previewWorker": {
          "type": "string",
          "minLength": 1
        },
        "artifactPrefix": {
          "type": "string",
          "minLength": 1
        },
        "stagingWorkflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["name", "path"]
        },
        "promotionWorkflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "titlePrefix": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["file", "titlePrefix", "branch"]
        },
        "artifactSource": {
          "enum": ["cf-output", "legacy-worker"]
        },
        "productionUrlEnv": {
          "type": "string",
          "minLength": 1
        },
        "previewUrlEnv": {
          "type": "string",
          "minLength": 1
        },
        "artifactAcceptance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forbiddenPaths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "forbiddenLanguages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "previewBindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "previewBindingsEnv": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/(?!/).*$"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "body": {
              "type": "string"
            }
          },
          "required": ["path", "status"]
        }
      },
      "required": []
    }
  },
  "required": ["version"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LVBT repository tooling declaration",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
